# Android 17 puts platform-signed apps with targetSdk < 37 (MiuiCamera targets 34)
# into platform_app_36 instead of platform_app. Mirror platform_app.te so the
# camera can find IMiPostProcService (otherwise SIGSEGV in libmicampostproc_client).
allow platform_app_36 app_data_file:file execute;
allow platform_app_36 vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;

binder_call(platform_app_36, hal_camera_default)

allow platform_app_36 vendor_audio_prop:file { open read getattr map };
allow platform_app_36 vendor_camera_sensor_prop:file { open read getattr map };
allow platform_app_36 vendor_camera_p3enable_prop:file { open read getattr map };
