+
+#ifndef __ANDROID__
+TEST(logd, get_buffer_size_from_properties_honors_overrides) {
+    EXPECT_EQ(kDefaultLogBufferSize, GetBufferSizeFromProperties(LOG_ID_MAIN));
+
+    ASSERT_TRUE(android::base::SetProperty("ro.debuggable", "0"));
+    ASSERT_TRUE(android::base::SetProperty("ro.hardware", "qcom"));
+    ASSERT_TRUE(android::base::SetProperty("ro.logd.size", "8M"));
+    ASSERT_TRUE(android::base::SetProperty("ro.logd.size.stats", "64K"));
+
+    EXPECT_EQ(8u * 1024 * 1024, GetBufferSizeFromProperties(LOG_ID_MAIN));
+    EXPECT_EQ(64u * 1024, GetBufferSizeFromProperties(LOG_ID_STATS));
+
+    ASSERT_TRUE(android::base::SetProperty("persist.logd.size", "4M"));
+    EXPECT_EQ(4u * 1024 * 1024, GetBufferSizeFromProperties(LOG_ID_MAIN));
+    ASSERT_TRUE(android::base::SetProperty("persist.logd.size", ""));
+}
+#endif
