diff --git a/configs/preferred-apps-miuicamera.xml b/configs/preferred-apps-miuicamera.xml
new file mode 100644
index 0000000..4a13fa0
--- /dev/null
+++ b/configs/preferred-apps-miuicamera.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Default handler for the lock-screen camera intent. MiuiCamera declares
+     STILL_IMAGE_CAMERA_SECURE on both .Camera and .AssistantCamera; without a
+     preference SystemUI gets the chooser and takes the dismiss-keyguard path. -->
+<preferred-activities>
+    <item name="com.android.camera/.Camera" match="100000" always="true" set="2">
+        <set name="com.android.camera/.Camera" />
+        <set name="com.android.camera/.AssistantCamera" />
+        <filter>
+            <action name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
+            <cat name="android.intent.category.DEFAULT" />
+        </filter>
+    </item>
+</preferred-activities>
diff --git a/device.mk b/device.mk
index 05aac5b..e6bd824 100644
--- a/device.mk
+++ b/device.mk
@@ -22,3 +22,14 @@ PRODUCT_SOONG_NAMESPACES += \
 # Sysconfig
 PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/configs/miuicamera-hiddenapi-package-allowlist.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/sysconfig/miuicamera-hiddenapi-package-allowlist.xml
+
+# Lock-screen camera: MiuiCamera .Camera is the default STILL_IMAGE_CAMERA_SECURE handler
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/configs/preferred-apps-miuicamera.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/preferred-apps/miuicamera.xml
+
+# Preload the MiuiCamera process (no UI) on screen-on so the lock-screen shortcut starts warm
+# (frameworks/base AppPreloader; off switch: setprop persist.sys.app_preload false)
+PRODUCT_SYSTEM_PROPERTIES += \
+    ro.config.app_preload.component=com.android.camera/.PreloadReceiver \
+    ro.config.app_preload.action=miui.intent.action.POPUP_UPDOWN_FAILED \
+    ro.config.app_preload.min_avail_mb=1536
